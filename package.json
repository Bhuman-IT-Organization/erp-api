{
  "name": "erp-api",
  "version": "0.0.0",
  "private": true,
  "description": "ERP backend: NestJS on Fastify, modular monolith (ADR-0001)",
  "type": "module",
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:contracts": "corepack yarn workspace @erp/contracts build",
    "build": "yarn build:contracts && tsc -p tsconfig.build.json && node scripts/copy-generated-runtime.mjs",
    "start": "node dist/main.js",
    "start:local": "yarn build && dotenv -e ../erp-infra/env/local/api.host.env -- node dist/main.js",
    "typecheck": "yarn build:contracts && prisma generate && node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "lint": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js .",
    "lint:prune": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js . --prune-suppressions",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "yarn build:contracts && vitest run",
    "test:coverage": "yarn build:contracts && vitest run --coverage",
    "test:mutation": "yarn build:contracts && stryker run",
    "check:arch": "node scripts/check-architecture-lint.mjs",
    "check:ratchet": "node configs/scripts/lint-ratchet.mjs --expect 140",
    "check:cycles": "depcruise src packages/contracts/src --config configs/dependency-cruiser.cjs",
    "check:audit": "yarn npm audit --all --recursive --severity high",
    "check:push": "yarn typecheck && yarn test",
    "check": "yarn typecheck && yarn lint && yarn check:ratchet && yarn check:cycles && yarn check:arch && yarn format && yarn test && yarn check:audit",
    "check:phase": "yarn typecheck && yarn lint && yarn check:ratchet && yarn check:cycles && yarn check:arch && yarn format && yarn test:coverage && yarn check:audit",
    "db:pull": "dotenv -e ../erp-infra/env/local/api.host.env -- prisma db pull && node scripts/fix-ignored-relations.mjs && prisma format && node scripts/introspection-report.mjs",
    "db:apply": "node scripts/apply-node-schema.mjs",
    "db:validate": "dotenv -e ../erp-infra/env/local/api.host.env -- prisma validate",
    "db:generate": "prisma generate",
    "db:report": "node scripts/introspection-report.mjs",
    "test:int": "dotenv -e ../erp-infra/env/local/api.host.env -- vitest run --config vitest.int.config.mts",
    "test:e2e": "node ../erp-infra/scripts/verify-wave0.mjs",
    "check:db": "yarn db:validate && yarn db:report && git diff --exit-code -- prisma/INTROSPECTION.md prisma/model-table-map.json && dotenv -e ../erp-infra/env/local/api.host.env -- node scripts/check-database-url.mjs",
    "postinstall": "prisma generate && node configs/scripts/git-hooks.mjs install"
  },
  "dependencies": {
    "@fastify/compress": "9.2.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/csrf-protection": "8.0.1",
    "@fastify/static": "10.1.4",
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-fastify": "12.0.3",
    "@nestjs/swagger": "12.0.1",
    "@prisma/client": "6.19.3",
    "@tus/file-store": "2.1.1",
    "@tus/server": "2.4.5",
    "bcryptjs": "3.0.3",
    "bidi-js": "1.1.0",
    "bullmq": "6.3.10",
    "bwip-js": "4.11.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "csv-parse": "7.0.3",
    "file-type": "22.1.1",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "nodemailer": "10.0.13",
    "opossum": "10.0.0",
    "pdfkit": "0.20.2",
    "read-excel-file": "9.3.10",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "winston": "3.19.0",
    "write-excel-file": "4.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@erp/configs": "link:./configs",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@nestjs/testing": "12.0.3",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@swc/core": "1.16.2",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/node": "^22.15.0",
    "@types/opossum": "8.1.9",
    "@types/pdfkit": "0.17.6",
    "@vitest/coverage-v8": "5.0.1",
    "@vitest/eslint-plugin": "1.6.27",
    "dependency-cruiser": "18.4.0",
    "dotenv-cli": "11.0.0",
    "eslint": "10.11.0",
    "eslint-plugin-jsdoc": "63.3.3",
    "fflate": "0.8.3",
    "lefthook": "2.1.14",
    "lint-staged": "16.4.0",
    "prettier": "^3.6.0",
    "prisma": "6.19.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "unplugin-swc": "1.6.0",
    "vite": "^8.3.0",
    "vitest": "5.0.1"
  },
  "dependenciesMeta": {
    "@scarf/scarf": {
      "built": false
    }
  }
}
