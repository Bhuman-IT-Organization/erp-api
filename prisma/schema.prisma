generator client {
  provider            = "prisma-client"
  output              = "../src/shared/db/generated"
  importFileExtension = "js"
  moduleFormat        = "esm"
  runtime             = "nodejs"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model tblacc_account_history {
  id                   Int       @id @default(autoincrement())
  account              Int
  debit                Decimal   @default(0.00) @db.Decimal(15, 2)
  credit               Decimal   @default(0.00) @db.Decimal(15, 2)
  description          String?   @db.Text
  rel_id               Int?
  rel_type             String?   @db.VarChar(45)
  datecreated          DateTime? @db.DateTime(0)
  addedfrom            Int?
  customer             Int?
  reconcile            Int       @default(0)
  split                Int       @default(0)
  item                 Int?
  paid                 Int       @default(0)
  date                 DateTime? @db.Date
  tax                  Int?
  payslip_type         String?   @db.VarChar(45)
  vendor               Int?
  itemable_id          Int?
  cleared              Int       @default(0)
  sub_type             String?   @db.VarChar(45)
  bill_item            Int       @default(0)
  number               String?   @db.VarChar(100)
  issue                Int       @default(0)
  added_from_reconcile Int       @default(0)
  bank_reconcile       Int       @default(0)
  currency_rate        Decimal?  @db.Decimal(15, 6)

  @@index([rel_id, rel_type], map: "transaction_link")
}

