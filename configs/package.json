{
  "name": "@erp/configs",
  "version": "0.0.0",
  "private": true,
  "description": "Shared configs of the ERP code repositories; consumed as a byte copy (D-02), an installed package later (D-03)",
  "type": "module",
  "exports": {
    "./tsconfig/*.json": "./tsconfig/*.json",
    "./eslint/*": "./eslint/*.mjs",
    "./prettier": "./prettier.config.mjs",
    "./dependency-cruiser": "./dependency-cruiser.cjs",
    "./vitest/*": {
      "types": "./vitest/*.d.mts",
      "default": "./vitest/*.mjs"
    },
    "./commitlint": "./commitlint.config.mjs",
    "./lint-staged": "./lint-staged.config.mjs"
  }
}
